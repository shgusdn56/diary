rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null && request.auth.token.email_verified == true; }
    function me() { return request.auth.token.email; }
    function isCreator() { return signed() && me() == 'shgusdn56@gmail.com'; }
    function space(s) { return get(/databases/$(database)/documents/spaces/$(s)).data; }
    function role(s) { return space(s).roles.get(me(), ''); }

    // 새 일지를 만들 수 있는 메일 목록 (제작자만 고침)
    match /config/{d} {
      allow read: if signed();
      allow write: if isCreator();
    }
    // 일지 공간: 초대된 메일만 보고, 주인만 초대·설정을 바꿔요
    match /spaces/{s} {
      allow read: if signed() && me() in resource.data.members;
      allow create: if signed() && request.resource.data.owner == request.auth.uid
        && request.resource.data.roles[me()] == 'owner'
        && (isCreator() || me() in get(/databases/$(database)/documents/config/allow).data.emails);
      allow update, delete: if signed() && resource.data.owner == request.auth.uid;

      match /{rest=**} {
        allow read: if signed() && role(s) != '';
        allow write: if signed() && role(s) in ['owner', 'edit'];
      }
      match /profiles/{u} {
        allow write: if signed() && request.auth.uid == u && role(s) != '';
      }
      // 내 알림 설정(수정 알림·오늘 일정 알림): '보기만' 권한이어도 내 것은 고칠 수 있어요
      match /notify/{u} {
        allow write: if signed() && request.auth.uid == u && role(s) != '';
      }
    }
    // 서버 작업 부탁(테스트 알림, PDF 테스트 메일, 공휴일 채우기, 시험판 올리기) — 만든 사람만 결과를 봐요
    match /jobs/{j} {
      allow read: if signed() && resource.data.by == request.auth.uid;
      allow create: if signed() && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(['kind', 'sid', 'by', 'at', 'test', 'to'])
        && ((request.resource.data.kind in ['test-edit', 'test-morning'] && role(request.resource.data.sid) != '')
          || (request.resource.data.kind == 'pdf' && request.resource.data.test == true && space(request.resource.data.sid).owner == request.auth.uid)
          || (request.resource.data.kind == 'invite' && space(request.resource.data.sid).owner == request.auth.uid && request.resource.data.to in space(request.resource.data.sid).members)
          || (request.resource.data.kind in ['holidays', 'release'] && isCreator()));
    }
    // 메일 보내는 계정(앱 비밀번호): 제작자만 쓰고, 아무도 읽지 못해요(서버만 읽어요)
    match /secret/{d} {
      allow read: if false;
      allow write: if isCreator();
    }
    // 나만 보는 칸 (일지 공간마다 따로)
    match /private/{u}/{rest=**} {
      allow read, write: if signed() && request.auth.uid == u;
    }
  }
}
